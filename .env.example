# Copy to .env and fill in. Never commit .env or a real key.
# Every third-party service stays in sandbox or test mode until Dapo says otherwise.

NODE_ENV=development

# --- Database (Supabase Postgres in staging/production; local Postgres in dev) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intu

# --- API ---
PORT=8787
# Browser origins allowed to call the API (admin console and intu scanner), comma-separated.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Supabase Auth (staff sign-in with two-step verification) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only: Project Settings → API keys → secret (service_role) key. Never in a browser or the repo.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses Supabase's legacy shared JWT secret; leave empty for signing keys.
SUPABASE_JWT_SECRET=
# Where invitation emails send new staff to set a password (the admin console's /set-password page).
ADMIN_INVITE_REDIRECT_URL=http://localhost:3001/set-password

# --- Member passes and the intu scanner ---
# Signs member passes (rotating QR codes): "<key id>:<base64url Ed25519 secret key>".
# Make one with `pnpm --filter @intu/qr keygen`. Required in staging and production; in development a
# throwaway key is used until the API restarts.
QR_SIGNING_KEY=
# Retired keys scanners should still trust until their passes expire (36 hours): "<id>:<public key>,…".
QR_PUBLIC_KEYS=
# Signs partner staff shift sessions (intu scanner). At least 32 random characters, e.g. `openssl rand -base64 32`.
PARTNER_SESSION_SECRET=
# Member app sign-in: the secret Supabase shows when you add the Send SMS hook (Authentication → Hooks), "v1,whsec_…".
SUPABASE_SMS_HOOK_SECRET=
# Who delivers sign-in codes. Only "test" for now: nothing is sent; TEST numbers set in Supabase use a fixed code.
CODE_SENDER=test
# The concierge's WhatsApp number, in E.164 (+234…). Leave blank to hide the button. (The doctor's line is the
# medical partner's service line, set on its venue in the console.)
CONCIERGE_WHATSAPP=
# Member photos: "supabase" (a private bucket, made on first upload) or "memory" for local development without Supabase.
PHOTO_STORE=supabase

# --- Admin console (apps/admin) and intu scanner (apps/partner), read by the browser, so only public values ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API keys → publishable key (sb_publishable_…). Safe in a browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Member app (apps/member), baked into the app at build time, so only public values ---
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# intu's Expo project, once the app is linked to the Expo account (expo.dev → project → Overview).
EXPO_PROJECT_ID=
EXPO_OWNER=
