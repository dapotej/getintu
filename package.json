{
  "name": "intu",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "db:generate": "pnpm --filter @intu/db generate",
    "db:migrate": "pnpm --filter @intu/db migrate",
    "db:seed": "pnpm --filter @intu/db seed",
    "db:reset": "pnpm --filter @intu/db reset"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
